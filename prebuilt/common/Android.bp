prebuilt_etc_xml {
    name: "sensitive_pn.xml",
    product_specific: true,
    src: "etc/sensitive_pn.xml",
    schema: ":spn-schema",
}

prebuilt_etc_xml {
    name: "halcyon-component-overrides.xml",
    product_specific: true,
    src: "etc/halcyon-component-overrides.xml",
    sub_dir: "sysconfig",
}

android_app_import {
	name: "Flipendo",
	apk: "app/Flipendo/Flipendo.apk",
	certificate: "platform",
	dex_preopt: {
		enabled: false,
	},
	system_ext_specific: true,
}